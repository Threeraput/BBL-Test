generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookmarks   Bookmark[]
  collections Collection[]
}

model Collection {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookmarks Bookmark[]
  owner     User       @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Bookmark {
  id           String      @id @default(uuid())
  url          String
  title        String
  notes        String?
  collectionId String?
  ownerId      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  collection   Collection? @relation(fields: [collectionId], references: [id])
  owner        User        @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([ownerId, collectionId])
}
